# syntax=docker/dockerfile:1

# Builder stage
FROM python:3.11-slim AS builder
WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl && rm -rf /var/lib/apt/lists/*

# Copy project metadata and install
COPY pyproject.toml README.md /app/
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir .

# Runtime stage
FROM python:3.11-slim
WORKDIR /app

# Create non-root user
RUN useradd -m mlp
USER mlp

# Copy installed packages from builder
COPY --from=builder /usr/local /usr/local
COPY src/ ./src/

ENV PYTHONPATH=/app/src \
    APP_MODULE=enterprise_ml_platform.api.main:app \
    PORT=8000

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s CMD curl -f http://localhost:$PORT/api/v1/health || exit 1

CMD ["uvicorn", "enterprise_ml_platform.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
